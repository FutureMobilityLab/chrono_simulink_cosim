// ChBrakeSimple.cpp uses "Maximum Torque" to scale
// the brake command to a torque. So by setting this
// to 1, we make the brake command in N*m.
{
  "Name":                       "Expedition Simple Brake",
  "Type":                       "Brake",
  "Template":                   "BrakeSimple",

  "Maximum Torque":             1
}
